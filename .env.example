# Public service identity
ETM_DOMAIN=classes.example.com
ACME_EMAIL=admin@example.com
# Keep 80/443 in production. Local Windows development may use 8080/8443.
ETM_HTTP_PORT=80
ETM_HTTPS_PORT=443

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
ETM_API_SECRET=replace-with-at-least-32-random-characters
N8N_CALLBACK_SECRET=replace-with-at-least-32-random-characters

# AI provider. Per-stage values may be empty to inherit AI_PROVIDER.
AI_PROVIDER=openai
TRANSCRIPTION_PROVIDER=
ANALYSIS_PROVIDER=
VISUAL_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Every request still requires HMAC. Add the n8n server and administrator public IPs.
ALLOWED_CIDRS=203.0.113.10/32,198.51.100.20/32
ALLOWED_YOUTUBE_CHANNEL_IDS=UC_REPLACE_WITH_AUTHORIZED_CHANNEL_ID
N8N_CALLBACK_URL=https://n8n.example.com/webhook/etm-class-analysis

# Processing limits
WORKER_CONCURRENCY=1
TRANSCRIPTION_CONCURRENCY=1
MAX_VIDEO_DURATION_SECONDS=14400
MIN_FREE_DISK_BYTES=1073741824
AUDIO_CHUNK_SECONDS=600
AUDIO_CHUNK_OVERLAP_SECONDS=3
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
OPENAI_VISUAL_MODEL=gpt-5.6-sol
OPENAI_REQUEST_TIMEOUT_MS=600000
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_VISUAL_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=600000
ENABLE_VISUAL_ANALYSIS=false
MAX_ANALYSIS_FRAMES=40
MAX_ANALYSIS_JSON_CHARACTERS=95000
CALLBACK_MAX_ATTEMPTS=6

# Optional host path. Create an empty 0600 file when cookies are not required.
YOUTUBE_COOKIES_HOST_PATH=./secrets/youtube_cookies
# Internal bgutil HTTP provider. An empty value omits PO Token arguments from yt-dlp.
YOUTUBE_PO_TOKEN_PROVIDER_URL=http://pot-provider:4416

# Local signing utility
ETM_API_BASE_URL=https://classes.example.com
