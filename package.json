{
  "name": "etm-class-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:web && prisma generate --schema packages/database/prisma/schema.prisma && tsc -p tsconfig.json",
    "build:web": "tsc -p apps/web/tsconfig.json --noEmit && vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner packages",
    "test:integration": "vitest run --configLoader runner tests/integration",
    "request:test": "tsx scripts/signed-request.ts",
    "job:export": "tsx scripts/export-job.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "6.12.0",
    "bullmq": "5.81.2",
    "fastify": "5.12.3",
    "fastify-raw-body": "5.0.0",
    "ioredis": "5.6.1",
    "ipaddr.js": "2.2.0",
    "openai": "5.11.0",
    "pino": "9.7.0",
    "prisma": "6.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.16.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.5",
    "prettier": "3.9.6",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.3.6",
    "vitest": "5.0.5"
  }
}
